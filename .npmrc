# pnpm configuration
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
use-lockfile=true

# Performance
lockfile-only=false
fetch-timeout=60000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Node modules resolution
node-linker=isolated

# Store location
store-dir=.pnpm-store
